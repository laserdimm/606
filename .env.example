# Environment example

# Server
PORT=8080
MERCHANT_ID=demo-merchant

# Private JWK (development) - set this to the JSON string of your private JWK or leave empty and use a key file
# Example (put the compact JSON string on one line):
PRIVATE_JWK_JSON=

# Stripe (test keys)
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# Square (sandbox)
SQUARE_ACCESS_TOKEN=sq0atp-sandbox_replace_me
SQUARE_LOCATION_ID=replace_me

# Coinbase Commerce
COINBASE_COMMERCE_API_KEY=replace_me

# Gemini / UCP
# For production you will publish a UCP profile JSON at a public URL and a JWKS URL for your public keys
GEMINI_UCP_PROFILE_URL=https://your-host.example.com/.well-known/ucp-profile.json
GEMINI_JWKS_URL=https://your-host.example.com/.well-known/jwks.json

